# EduRAG environment contract. Copy this file to .env and replace all secret placeholders.
# Application
EDURAGE_ENV=dev
EDURAGE_LOG_LEVEL=INFO
EDURAGE_API_HOST=0.0.0.0
EDURAGE_API_PORT=8000

# LLM and embeddings
EDURAGE_LLM_PROVIDER=deepseek
EDURAGE_LLM_API_KEY=replace-with-your-deepseek-api-key
EDURAGE_LLM_BASE_URL=https://api.deepseek.com
EDURAGE_LLM_MODEL=deepseek-chat
EDURAGE_EMBEDDING_PROVIDER=dashscope
EDURAGE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EDURAGE_EMBEDDING_API_KEY=replace-with-your-dashscope-api-key
EDURAGE_EMBEDDING_MODEL=text-embedding-v3

# Vector and relational storage
EDURAGE_VECTOR_STORE=qdrant
EDURAGE_QDRANT_URL=http://qdrant:6333
EDURAGE_POSTGRES_DSN=postgresql+psycopg://edurage:edurage@postgres:5432/edurage

# Object storage
EDURAGE_MINIO_ENDPOINT=minio:9000
EDURAGE_MINIO_BUCKET=edurage-docs
EDURAGE_MINIO_ACCESS_KEY=replace-with-minio-access-key
EDURAGE_MINIO_SECRET_KEY=replace-with-minio-secret-key

# Privacy switch: keep false unless cloud upload is explicitly allowed.
EDURAGE_ALLOW_CLOUD_UPLOAD=false

# ED-01 data and model defaults
EDURAGE_EMBEDDING_DIM=1024
EDURAGE_EMBEDDING_BATCH_SIZE=10
EDURAGE_QDRANT_COLLECTION=edurage_chunks
EDURAGE_CHUNK_SIZE=500
EDURAGE_CHUNK_OVERLAP=80
EDURAGE_UPLOAD_MAX_MB=20
EDURAGE_TOP_K=5
EDURAGE_VECTOR_WEIGHT=0.6
EDURAGE_KEYWORD_WEIGHT=0.4
EDURAGE_CANDIDATE_K=20
EDURAGE_LLM_TEMPERATURE=0.1
EDURAGE_LLM_TIMEOUT_S=60

# Selective local OCR. Requires the Tesseract binary and matching language data.
EDURAGE_OCR_ENABLED=false
EDURAGE_OCR_ENGINE=tesseract
EDURAGE_OCR_DPI=180
EDURAGE_OCR_MIN_TEXT_CHARS=80
EDURAGE_OCR_MIN_IMAGE_RATIO=0.35
EDURAGE_OCR_LANGUAGE=chi_sim+eng
